{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "angular",
  "installCommand": "npm ci",
  "buildCommand": "npx ng build --configuration production",
  "outputDirectory": "dist/front-end-rabi-gamaliel/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://rabigamaliel-api.onrender.com/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
